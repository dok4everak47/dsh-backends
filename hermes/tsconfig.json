{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@deepseek-harness-tui/dsh-tui/lib/types/*": [
        "./node_modules/@deepseek-harness-tui/dsh-tui/lib/types/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}

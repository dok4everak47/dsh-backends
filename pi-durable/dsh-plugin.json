{
  "$schema": "https://dsh-tui-ecosystem.github.io/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "dok4ever.pi-backend",
  "name": "Pi Durable Backend for dsh-tui",
  "version": "0.1.0",
  "facets": {
    "host": {
      "entry": "./dist/register.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      { "apiVersion": "tui.dsh/v1alpha1", "kind": "Backend" }
    ]
  },
  "permissions": [],
  "contributes": {
    "commands": [],
    "x-dsh-tui": [
      {
        "kind": "Backend",
        "apiVersion": "tui.dsh/v1alpha1",
        "id": "pi",
        "name": "pi",
        "spec": {
          "id": "pi",
          "label": { "text": "Pi (Durable)" },
          "shortLabel": "Pi",
          "capabilities": ["models"],
          "grants": []
        }
      }
    ]
  },
  "subscriptions": []
}
